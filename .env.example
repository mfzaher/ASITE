# One application integration for all users. Never commit real values.
ASITE_CLIENT_ID=
ASITE_CLIENT_SECRET=
# Generate a random 32+ character value and store it securely in Vercel.
SESSION_SECRET=

# Governance workspace: setup generates local secrets. Use HTTPS origins when hosting.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ECC_PUBLIC_ORIGIN=http://localhost:3000
ECC_DATABASE_PATH=.data/ecc.sqlite
# Single-user loopback development only; ignored in production.
ECC_LOCAL_MODE=0
# Monthly audit worker: explicit entities and a random 32+ character secret.
ECC_CRON_SECRET=
ECC_AUDIT_ENTITIES=
# Read-only reporting service: explicit entities and a separate random secret.
ECC_REPORTING_TOKEN=
ECC_REPORTING_ENTITIES=
# Optional approved models; no default model is chosen.
AI_GATEWAY_API_KEY=
ECC_AI_MODEL=
ECC_EMBEDDING_MODEL=
